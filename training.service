# Template. Install with the sed command in README.md, which fills in
# __USER__ and __DIR__ for your machine.
[Unit]
Description=Training tracker
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=/usr/bin/python3 __DIR__/server.py
Restart=always
RestartSec=3

# Only the data directory is writable; everything else is read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=__DIR__/data

[Install]
WantedBy=multi-user.target
