[Unit]
Description=Training tracker
After=network.target

[Service]
Type=simple
User=bookenpi
WorkingDirectory=/home/bookenpi/training
ExecStart=/usr/bin/python3 /home/bookenpi/training/server.py
Restart=always
RestartSec=3

# Only the data directory is writable; everything else is read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/home/bookenpi/training/data

[Install]
WantedBy=multi-user.target
